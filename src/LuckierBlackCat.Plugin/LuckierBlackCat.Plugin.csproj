<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>LuckierBlackCat</AssemblyName>
    <RootNamespace>LuckierBlackCat</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuckierBlackCat.Core\LuckierBlackCat.Core.csproj" />
    <ProjectReference Include="..\LuckierBlackCat.Patching\LuckierBlackCat.Patching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\ref\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>..\..\ref\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity">
      <HintPath>..\..\ref\BepInEx.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elin">
      <HintPath>..\..\ref\Elin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins.BaseCore">
      <HintPath>..\..\ref\Plugins.BaseCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins.Sound">
      <HintPath>..\..\ref\Plugins.Sound.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\ref\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\ref\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\package.xml" Link="package.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\preview.jpg" Link="preview.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README_EN.md" Link="README_EN.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README_JP.md" Link="README_JP.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LangConfig\*.xlsx"
             Link="LangConfig\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyToElinPackage"
          AfterTargets="Build"
          Condition="'$(ElinPackageDir)' != ''">
    <ItemGroup>
      <ElinPackageFile Include="$(TargetDir)LuckierBlackCat.dll" />
      <ElinPackageFile Include="$(TargetDir)LuckierBlackCat.Core.dll" />
      <ElinPackageFile Include="$(TargetDir)LuckierBlackCat.Patching.dll" />
      <ElinPackageFile Include="$(TargetDir)package.xml" />
      <ElinPackageFile Include="$(TargetDir)preview.jpg" />
      <ElinPackageFile Include="$(TargetDir)LICENSE.txt" />
      <ElinPackageFile Include="$(TargetDir)README*.md" />
      <ElinLangConfigFile Include="$(TargetDir)LangConfig\*.xlsx" />
    </ItemGroup>
    <Copy SourceFiles="@(ElinPackageFile)"
          DestinationFolder="$(ElinPackageDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ElinLangConfigFile)"
          DestinationFolder="$(ElinPackageDir)\LangConfig"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
